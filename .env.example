# Web3Forms access key for the contact form.
# 1. Go to https://web3forms.com
# 2. Enter the email where you want to receive messages (e.g. memankhadim@gmail.com)
# 3. Check that inbox for the access key they send you
# 4. Copy this file to ".env" and paste the key below (no quotes)
# 5. Restart the dev server (npm run dev)
VITE_WEB3FORMS_ACCESS_KEY=

# Groq API key for the AI Playground chat. Free key: https://console.groq.com/keys
# NOTE: VITE_ vars are bundled into the browser build and are publicly visible.
# Use a free/throwaway key and rotate it if it gets abused.
VITE_GROQ_API_KEY=
